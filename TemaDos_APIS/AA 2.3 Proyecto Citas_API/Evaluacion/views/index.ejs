<!DOCTYPE html>
<html>

<head>
  <title>Personajes Anime</title>
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

  <h1>Personaje de Anime</h1>

  <div class="card">
    <img src="/public/images/ambiente.jpg" alt="personaje" style="width:150px; border-radius:10px;">
    <p>
      <%= quote %>
    </p>
  </div>

  <p class="character">
    <%= character %>
  </p>

  <form method="GET" action="/">
    <button>Otro personaje</button>
  </form>

</body>
</html>